<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  dualswitch launchd 用户代理模板。
  __PYTHON__ / __ROOT__ / __HOME__ 由 install.sh 替换，请勿直接使用本文件。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dualswitch.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>dualswitch</string>
        <string>run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__ROOT__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <string>__ROOT__/src</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <false/>

    <key>ProcessType</key>
    <string>Interactive</string>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/dualswitch.out.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/dualswitch.err.log</string>
</dict>
</plist>
